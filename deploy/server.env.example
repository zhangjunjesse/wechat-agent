# Copy to /opt/wechat-agent/server.env and fill values. Never commit server.env.
# Any OpenAI-compatible endpoint works (official DeepSeek API, or an internal
# gateway/proxy). src/llm/deepseek-thinking-client.mjs round-trips
# `reasoning_content` through multi-turn tool calls, which every DeepSeek model
# this project has run (deepseek-flash, deepseek-v4-flash) requires
# (verified 2026-09-16: 3-turn smoke test incl. a forced tool call).
# Since ADR-0033 that wrap is GATED ON THE MODEL NAME (/deepseek/i): non-DeepSeek
# models get the raw client, because `reasoning_content` is DeepSeek-proprietary.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://120.78.77.32:4000/v1
OPENAI_MODEL=deepseek-v4-flash
# 专家模式（ADR-0033）：用户对助手说「切换到专家模式」后，该用户接下来
# EXPERT_MODE_TTL_MINUTES 分钟改用这个更强的模型，到点惰性过期、静默恢复
# OPENAI_MODEL。留空则整个特性不启用（工具不注册，路由纯透传，行为与未加此
# 功能完全一致）。定时任务（日报/周报/digest）不受影响，仍用 OPENAI_MODEL。
EXPERT_MODEL=gpt-5.6-sol
EXPERT_MODE_TTL_MINUTES=60
# 专家模式状态文件（userId -> 到期时刻）。容器 cwd 是 /，所以默认相对路径
# data/expert-mode.json 在生产解析到 /data/expert-mode.json（已挂载持久卷）。
EXPERT_MODE_FILE=/data/expert-mode.json
AGENT_SDK=openai
WECHAT_SYNC_BASE_URL=https://datadefender.cn
WECHAT_SYNC_ACCESS_KEY=
# RedFoxHub API key for the wechat-gzh-research skill (gzh_search / gzh_content,
# see ADR-0013). Get one at https://redfox.hk/settings/api-keys
REDFOX_API_KEY=
# Set to 1 to enable the manage_skill runtime tool (add/update/remove skills).
ADMIN_SKILLS=0
BINDINGS_FILE=/data/bindings.json
PROFILES_FILE=/data/profiles.json
ASSISTANT_QR_FILE=/app/assistant-qr.jpg
# Read-only mount of the wechat-sync receiver's SQLite DB (see docker-compose.yml
# volumes and ADR-0007). Omit/leave unset to disable the wechat_* search tools.
WECHAT_LOG_DB=/wechat-sync-data/sync_inbox.db
# Historical chat attachments (ADR-0029): media files live alongside the DB
# above at <same mount>/media/<media_id>.<ext>. Default is derived from
# WECHAT_LOG_DB's directory + "/media" — only set this if media lives
# somewhere else. Enables wechat_fetch_chat_file when WECHAT_LOG_DB is set.
WECHAT_MEDIA_DIR=
# Image understanding (ADR-0030): model name for the image_describe tool,
# called via a standalone one-shot request (NOT the main deepseek-thinking
# chain) reusing OPENAI_BASE_URL/OPENAI_API_KEY above. Leave unset and the
# tool simply does not register (fail-closed) — no error, just absent.
VISION_MODEL=
# 微信日报/周报（DESIGN-wechat-digest.md）：群画像库路径，独立于 tasks/reports.db。
DIGEST_FILE=/data/digest.db
# 三节全空（"今天各群平静"）时是否仍发一句短文本。设为 0 则彻底静默，什么都不发。
# 默认 1（发一句），与 TaskScheduler 构造时的默认值保持一致。
DIGEST_QUIET_PUSH=1
