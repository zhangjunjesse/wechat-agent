# Copy to /opt/wechat-agent/server.env and fill values. Never commit server.env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AGENT_SDK=openai
WECHAT_SYNC_BASE_URL=https://datadefender.cn
WECHAT_SYNC_ACCESS_KEY=
BINDINGS_FILE=/data/bindings.json
PROFILES_FILE=/data/profiles.json
ASSISTANT_QR_FILE=/app/assistant-qr.jpg
# Read-only mount of the wechat-sync receiver's SQLite DB (see docker-compose.yml
# volumes and ADR-0007). Omit/leave unset to disable the wechat_* search tools.
WECHAT_LOG_DB=/wechat-sync-data/sync_inbox.db
